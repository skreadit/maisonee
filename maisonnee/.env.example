# Démonstration locale uniquement. Copier vers .env.local.
# Les comptes et chefs fictifs ne doivent jamais servir à une ouverture commerciale.
APP_MODE=demo
APP_URL=http://127.0.0.1:3000
PGLITE_DATA_DIR=./data/maisonnee

# Hors démo : APP_MODE=production, PostgreSQL vierge dédié et origine HTTPS.
# L'administration reste bloquée hors démo jusqu'à livraison d'un MFA vérifié.
# Ne jamais partager bases et secrets entre local, staging et production.
DATABASE_URL=
# Au moins 32 caractères aléatoires hors démo ; utilisé pour le limiteur de débit.
# Ne pas exposer en NEXT_PUBLIC_ ni enregistrer dans le dépôt.
AUTH_SECRET=
# true seulement derrière un proxy maîtrisé qui remplace X-Forwarded-For.
# Sinon les appels anonymes partagent le même quota (comportement conservateur).
TRUST_PROXY=false

# Délais techniques du pilote (heures entières entre 1 et 168).
# Le créneau est libéré à l'échéance seulement sans paiement ni tentative Stripe ouverte.
# Aucun barème d'annulation ou remboursement n'est défini par ces délais.
REQUEST_TTL_HOURS=24
PAYMENT_TTL_HOURS=24

# Stripe sandbox uniquement. Clés sk_live_ et événements livemode refusés.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Renseigner les deux seulement après validation de la procédure d'annulation.
# Mode autorisé : manual_admin_review. Aucun barème commercial implicite.
REFUND_POLICY_MODE=
REFUND_POLICY_VERSION=

# E-mails, SMS, carte, analytics, supervision et stockage privé non connectés.
# Aucun identifiant pour ces services n'est nécessaire au fonctionnement local.
